DASHSCOPE_API_KEY=
QWEN_WORKSPACE_ID=
QWEN_REALTIME_MODEL=qwen3.5-omni-plus-realtime
QWEN_REALTIME_VOICE=Ethan
QWEN_REALTIME_INSTRUCTIONS=你是一名自然、简洁、有同理心的中文语音助手。先听完用户的话，再用口语化中文回答。
QWEN_VAD_TYPE=server_vad
QWEN_VAD_THRESHOLD=0.5
QWEN_VAD_PREFIX_PADDING_MS=300
QWEN_VAD_SILENCE_MS=500
# 如需覆盖完整 WebSocket 地址，可填写下面一项并保留 model 查询参数。
# QWEN_REALTIME_URL=wss://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
# 已有的 DashScope API Key 也可使用兼容地址：
# QWEN_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
